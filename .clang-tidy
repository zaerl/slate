#
# Static analysis configuration. Run with `make tidy`.
#
# bugprone-signed-bitwise (LLVM 23+) is off: it flags every shift by a plain int literal, even on
# unsigned 64-bit values, which is how the hashing and control-byte code is written.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-casting,
  readability-redundant-parentheses,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -cert-err33-c,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.VAList,
  -misc-include-cleaner,
  -misc-no-recursion,
  -performance-no-int-to-ptr,
  -portability-avoid-pragma-once

WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*/(unicode-data\.h|attractor\.h|getopt/.*)$'
FormatStyle: file
